{
  "schemaVersion": 1,
  "id": "${id}",
  "version": "${version}",
  "name": "${name}",
  "description": "${desc}",
  "authors": [
    "litetex",
    "JustHari01"
  ],
  "contributors": [
    {
      "name": "Cael & Capes mod contributors",
      "contact": {
        "homepage": "https://github.com/CaelTheColher/Capes"
      }
    },
    {
      "name": "JustHari01",
      "contact": {
        "homepage": "https://modrinth.com/mod/${modrinth_project_slug}"
      }
    }
  ],
  "contact": {
    "homepage": "https://modrinth.com/mod/${modrinth_project_slug}",
    "sources": "https://github.com/litetex-oss/mcm-${id}",
    "issues": "https://modrinth.com/mod/${modrinth_project_slug}"
  },
  "license": "${license_spdx_id}",
  "icon": "assets/icon.png",
  "environment": "client",
  "entrypoints": {
    "client": [
      "net.litetex.capes.fabric.FabricCapes"
    ],
    "modmenu": [
      "net.litetex.capes.fabric.compat.ModMenuCompatibility"
    ]
  },
  "mixins": [
    "cape-provider.mixins.json"
  ],
  "accessWidener": "cape-provider.accesswidener",
  "depends": {
    "fabricloader": ">=${loader_version}",
    "minecraft": "${minecraft_version}",
    "fabric-api": ">=${fabric_api_version}"
  },
  "recommends": {
    "modmenu": ">=${modmenu_version}"
  },
  "breaks": {
    "capes": "*"
  },
  "conflicts": {
    "minecraftcapes": "*",
    "capemod": "*",
    "cicada": "*",
    "bettercapes": "*"
  },
  "custom": {
    "cape": "Contributors",
    "modmenu": {
      "links": {
        "modmenu.modrinth": "https://modrinth.com/mod/${modrinth_project_slug}"
      }
    }
  }
}
